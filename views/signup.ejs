<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Tubig | Sign Up</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      background: linear-gradient(165deg, #0a4d68 0%, #0d7b9c 28%, #2a9d8f 55%, #1a5f7a 85%, #053b50 100%);
      font-family: 'Segoe UI', sans-serif;
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 120% 80% at 50% -20%, rgba(255, 255, 255, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse 80% 50% at 80% 100%, rgba(42, 157, 143, 0.25) 0%, transparent 45%);
      pointer-events: none;
      z-index: 0;
    }
    .water-scene { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
    .ceiling-highlight {
      position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.35) 50%, transparent);
    }
    .water-surface {
      position: absolute; left: 0; right: 0; bottom: 0; height: 84px;
      background: linear-gradient(180deg, rgba(225,252,255,.25), rgba(20,95,120,.5));
    }
    .card {
      position: relative; z-index: 2;
      width: 100%; max-width: 420px; margin: 1.25rem;
      padding: 2rem 2.2rem; border-radius: 20px;
      background: rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(20px) saturate(160%);
      border: 1px solid rgba(255, 255, 255, 0.35);
      box-shadow: 0 8px 32px rgba(0, 30, 50, 0.25);
    }
    .brand {
      display: flex; align-items: center; gap: 8px; margin-bottom: 1.4rem;
      color: rgba(232, 250, 255, 0.95); font-weight: 700; font-size: 15px;
    }
    h1 { font-size: 22px; font-weight: 700; color: #0f2942; margin-bottom: 4px; }
    .subtitle { font-size: 13px; color: rgba(20, 40, 60, 0.78); margin-bottom: 1.4rem; }
    label { display: block; font-size: 13px; font-weight: 600; color: rgba(26, 40, 55, 0.92); margin-bottom: 6px; }
    input[type="email"], input[type="password"], input[type="text"] {
      width: 100%; border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 10px;
      padding: 10px 14px; font-size: 14px; color: #1a2744;
      background: rgba(255, 255, 255, 0.32); outline: none; margin-bottom: 1rem;
    }
    input:focus {
      border-color: rgba(74, 200, 220, 0.65);
      background: rgba(255, 255, 255, 0.42);
      box-shadow: 0 0 0 3px rgba(120, 210, 240, 0.25);
    }
    .input-error { border-color: #e53e3e !important; }
    .error-msg { color: #c53030; font-size: 12px; margin-top: -6px; margin-bottom: 12px; font-weight: 500; }
    .password-wrap { position: relative; margin-bottom: 1rem; }
    .password-wrap input { margin-bottom: 0; padding-right: 40px; }
    .toggle-pw {
      position: absolute; right: 12px; top: 0; height: 100%;
      display: flex; align-items: center; justify-content: center;
      background: none; border: none; cursor: pointer; color: rgba(45, 70, 90, 0.55);
    }
    .btn-continue {
      width: 100%;
      background: linear-gradient(135deg, rgba(13, 123, 156, 0.95), rgba(10, 77, 104, 0.98));
      color: #fff; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 10px;
      padding: 12px; font-size: 15px; font-weight: 600; cursor: pointer;
      box-shadow: 0 4px 16px rgba(5, 50, 70, 0.35);
    }
    .btn-continue:hover { filter: brightness(1.06); }
    .footer-text { text-align: center; font-size: 13px; color: rgba(25, 45, 60, 0.75); margin-top: 1.2rem; }
    .footer-text a { color: rgba(8, 90, 115, 0.95); text-decoration: none; font-weight: 600; }
    .footer-text a:hover { text-decoration: underline; }
    .role-note { font-size: 12px; color: rgba(20, 40, 60, 0.65); margin: -6px 0 1rem; }
  </style>
</head>
<body>

<div class="water-scene" aria-hidden="true">
  <div class="ceiling-highlight"></div>
  <div class="water-surface"></div>
</div>

<div class="card">
  <div class="brand">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M12 2L4 9v11h5v-6h6v6h5V9z" fill="#1a8fc1"/>
      <polygon points="12,2 20,9 4,9" fill="#29b6d1"/>
    </svg>
    E-Tubig
  </div>

  <h1>Create Account</h1>
  <p class="subtitle">Register to access the water monitoring dashboard</p>

  <% if (error) { %>
    <p class="error-msg"><%= error %></p>
  <% } %>

  <form action="/signup" method="POST">
    <label for="full_name">Full name</label>
    <input type="text" id="full_name" name="full_name"
           value="<%= values.full_name || '' %>"
           placeholder="Juan Dela Cruz" required />

    <label for="email">Email address</label>
    <input type="email" id="email" name="email"
           value="<%= values.email || '' %>"
           placeholder="hello@example.com" required />

    <label for="password">Password</label>
    <div class="password-wrap">
      <input type="password" id="password" name="password"
             class="<%= error ? 'input-error' : '' %>"
             placeholder="At least 6 characters" minlength="6" required />
      <button type="button" class="toggle-pw" data-target="password" aria-label="Show password">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <ellipse cx="12" cy="12" rx="10" ry="6"/><circle cx="12" cy="12" r="2.5"/>
        </svg>
      </button>
    </div>

    <label for="confirm_password">Confirm password</label>
    <div class="password-wrap">
      <input type="password" id="confirm_password" name="confirm_password"
             placeholder="Re-enter password" minlength="6" required />
      <button type="button" class="toggle-pw" data-target="confirm_password" aria-label="Show password">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <ellipse cx="12" cy="12" rx="10" ry="6"/><circle cx="12" cy="12" r="2.5"/>
        </svg>
      </button>
    </div>

    <p class="role-note">New accounts are created as <strong>operator</strong> role.</p>

    <button type="submit" class="btn-continue">CREATE ACCOUNT</button>
  </form>

  <p class="footer-text">
    Already have an account?
    <a href="/">Sign in here</a>
  </p>
</div>

<script>
  document.querySelectorAll('.toggle-pw').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.getAttribute('data-target'));
      if (input) input.type = input.type === 'password' ? 'text' : 'password';
    });
  });
</script>
</body>
</html>
