<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Tubig | Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    html::-webkit-scrollbar,
    body::-webkit-scrollbar,
    .main::-webkit-scrollbar,
    .content::-webkit-scrollbar { display: none; }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      display: flex;
      min-height: 100vh;
    }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 210px;
      min-height: 100vh;
      background: #fff;
      border-right: 1px solid #e8ecf0;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 100;
      overflow-y: auto;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .sidebar::-webkit-scrollbar { display: none; }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 1.3rem 1.4rem;
      color: #1a8fc1;
      font-weight: 700;
      font-size: 16px;
      border-bottom: 1px solid #f0f4f8;
    }

    .sidebar-brand svg { flex-shrink: 0; }

    .sidebar-nav {
      flex: 1;
      padding: 1rem 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 1.4rem;
      font-size: 14px;
      color: #6b7280;
      text-decoration: none;
      border-radius: 0;
      cursor: pointer;
      transition: background .15s, color .15s;
    }

    .nav-item:hover { background: #f0f7fb; color: #1a8fc1; }

    .nav-item.active {
      background: #e8f4fb;
      color: #1a8fc1;
      font-weight: 600;
      border-right: 3px solid #1a8fc1;
    }

    .nav-item svg { width: 17px; height: 17px; flex-shrink: 0; }

    .sidebar-bottom {
      padding: 1rem 0;
      border-top: 1px solid #f0f4f8;
    }

    /* ── MAIN ── */
    .main {
      margin-left: 210px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* ── TOPBAR ── */
    .topbar {
      background: #fff;
      border-bottom: 1px solid #e8ecf0;
      padding: .75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar-icon {
      position: relative;
      width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%;
      background: #f4f6f9;
      cursor: pointer;
      color: #6b7280;
    }

    .topbar-icon:hover { background: #e8f4fb; color: #1a8fc1; }

    .topbar-action {
      position: relative;
    }

    .topbar-popover {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 290px;
      background: #fff;
      border: 1px solid #e8ecf0;
      border-radius: 12px;
      box-shadow: 0 14px 30px rgba(26, 35, 56, 0.12);
      padding: .8rem;
      display: none;
      z-index: 80;
    }

    .topbar-popover.show { display: block; }

    .popover-title {
      font-size: 13px;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: .65rem;
    }

    .popover-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .45rem;
    }

    .popover-item {
      border: 1px solid #eef2f7;
      border-radius: 8px;
      padding: .55rem .65rem;
      background: #f9fbfd;
    }

    .popover-item strong {
      display: block;
      font-size: 12px;
      color: #1a1a2e;
      margin-bottom: 2px;
    }

    .popover-item span {
      font-size: 12px;
      color: #6b7280;
      line-height: 1.35;
      display: block;
    }

    .avatar-panel {
      width: 250px;
    }

    .avatar-head {
      display: flex;
      align-items: center;
      gap: .65rem;
      margin-bottom: .65rem;
      padding-bottom: .65rem;
      border-bottom: 1px solid #eef2f7;
    }

    .avatar-chip {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #1a8fc1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
    }

    .avatar-meta strong {
      display: block;
      font-size: 13px;
      color: #1a1a2e;
    }

    .avatar-meta span {
      font-size: 12px;
      color: #6b7280;
    }

    .avatar-actions {
      display: flex;
      flex-direction: column;
      gap: .35rem;
    }

    .avatar-actions a {
      text-decoration: none;
      font-size: 12px;
      color: #1a8fc1;
      font-weight: 600;
      padding: 4px 2px;
    }

    .avatar-actions a:hover { color: #157aab; }

    .badge {
      position: absolute;
      top: -2px; right: -2px;
      width: 17px; height: 17px;
      border-radius: 50%;
      font-size: 10px;
      font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      color: #fff;
    }

    .badge-blue { background: #1a8fc1; }
    .badge-indigo { background: #5b5fcf; }

    .avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: #cbd5e0;
      overflow: hidden;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; color: #fff; font-size: 14px;
    }

    /* ── CONTENT ── */
    .content {
      padding: 1.8rem 2rem;
      flex: 1;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .greeting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.4rem;
    }

    .greeting {
      font-size: 17px;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 0;
    }

    .greeting span {
      font-weight: 400;
      color: #6b7280;
      font-size: 15px;
    }

    .history-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 10px;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      color: #0f2942;
      background: rgba(255, 255, 255, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.5);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: background .15s, border-color .15s, color .15s;
    }

    .history-btn:hover {
      background: rgba(255, 255, 255, 0.75);
      border-color: rgba(26, 143, 193, 0.5);
      color: #065a73;
    }

    .history-wrap {
      position: relative;
      flex-shrink: 0;
    }

    .history-menu {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      min-width: 320px;
      max-width: 360px;
      max-height: 280px;
      overflow-y: auto;
      padding: 10px;
      border-radius: 12px;
      background: rgba(238, 248, 254, 0.58);
      border: 1px solid rgba(255, 255, 255, 0.55);
      box-shadow: 0 14px 28px rgba(0, 30, 50, 0.18);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: none;
      z-index: 70;
    }

    .history-menu.show {
      display: block;
    }

    .history-item {
      background: rgba(255, 255, 255, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.48);
      border-radius: 9px;
      padding: 8px 10px;
      margin-bottom: 8px;
      color: #142434;
    }

    .history-item:last-child {
      margin-bottom: 0;
    }

    .history-item-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      color: #4f6171;
      margin-bottom: 4px;
    }

    .history-item-metrics {
      font-size: 12px;
      line-height: 1.45;
      color: #0d2438;
      font-weight: 600;
    }

    /* ── METRIC CARDS ── */
    .metric-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 1.4rem;
    }

    .metric-card {
      background: #fff;
      border: 1px solid #e8ecf0;
      border-radius: 12px;
      padding: 1.15rem 1.2rem;
      position: relative;
      overflow: hidden;
      min-height: 150px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      text-align: center;
    }

    .metric-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, #1a8fc1, #29b6d1);
    }

    .metric-label {
      font-size: 18px;
      color: #9aa3af;
      margin-bottom: 12px;
      letter-spacing: .3px;
    }

    .metric-value {
      font-size: 40px;
      font-weight: 700;
      color: #1a1a2e;
      line-height: 1.05;
      margin-top: auto;
      margin-bottom: auto;
    }

    .metric-unit {
      font-size: 18px;
      font-weight: 500;
      color: #6b7280;
      margin-left: 5px;
    }

    /* Water quality + potability row */
    .charts-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 1rem;
      margin-bottom: 1.4rem;
    }

    .chart-card {
      background: #fff;
      border: 1.5px solid #c8e6f5;
      border-radius: 14px;
      padding: 1.2rem 1.4rem;
    }

    .chart-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    .chart-title {
      font-size: 15px;
      font-weight: 700;
      color: #1a1a2e;
      margin-right: auto;
    }

    .period-btn {
      background: none;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      padding: 4px 12px;
      font-size: 12px;
      color: #6b7280;
      cursor: pointer;
      transition: all .15s;
    }

    .period-btn.active {
      background: #fff;
      border-color: #1a1a2e;
      color: #1a1a2e;
      font-weight: 600;
    }

    .period-btn:hover:not(.active) { border-color: #1a8fc1; color: #1a8fc1; }

    .chart-wrap { position: relative; height: 200px; }

    /* Potability Card */
    .potability-card {
      background: #fff;
      border: 1.5px solid #c8e6f5;
      border-radius: 14px;
      padding: 1.4rem;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      text-align: center;
    }

    .potability-title {
      font-size: 15px;
      font-weight: 700;
      color: #1a1a2e;
    }

    .potability-icon {
      width: 64px; height: 64px;
      display: flex; align-items: center; justify-content: center;
    }

    .potability-status {
      font-size: 18px;
      font-weight: 700;
      color: #1a1a2e;
    }

    .potability-bar {
      width: 80%;
      height: 3px;
      background: linear-gradient(90deg, #1a8fc1, #29b6d1);
      border-radius: 4px;
    }

    /* Full-width chart */
    .chart-card-full {
      background: #fff;
      border: 1.5px solid #c8e6f5;
      border-radius: 14px;
      padding: 1.2rem 1.4rem;
    }

    .chart-wrap-full { position: relative; height: 200px; }

    .consumption-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 1rem;
    }

    .flow-side-card {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      min-height: 100%;
      padding: 1.3rem 1.1rem;
    }

    .flow-side-card .metric-label {
      font-size: 14px;
      margin-bottom: 12px;
      font-weight: 600;
      color: #4f6171;
    }

    .flow-side-card .metric-value {
      font-size: 38px;
      line-height: 1.05;
      color: #0d2438;
    }

    .flow-side-card .metric-unit {
      font-size: 16px;
      font-weight: 600;
      margin-left: 6px;
      color: #395a6c;
    }
  <%- include('partials/glass-app-theme') %>
  </style>
</head>
<body>

<!-- ── SIDEBAR ── -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M12 2L4 9v11h5v-6h6v6h5V9z" fill="#1a8fc1"/>
      <polygon points="12,2 20,9 4,9" fill="#29b6d1"/>
    </svg>
    E-Tubig
  </div>

  <nav class="sidebar-nav">
    <a href="/dashboard" class="nav-item active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      Dashboard
    </a>
    <a href="/monitoring" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      Real-Time Monitoring
    </a>
    <a href="/water-quality" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6 9 4 13 4 16a8 8 0 0016 0c0-3-2-7-8-14z"/></svg>
      Water Quality
    </a>
    <a href="/consumption" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      Consumption
    </a>
    <a href="/alerts" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Alerts
    </a>
    <a href="/history" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h18"/><rect x="2" y="3" width="4" height="4" rx="1"/><rect x="2" y="10" width="4" height="4" rx="1"/><rect x="2" y="17" width="4" height="4" rx="1"/></svg>
      History/Logs
    </a>
    <a href="/reports" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="9" y1="7" x2="15" y2="7"/><line x1="9" y1="11" x2="15" y2="11"/><line x1="9" y1="15" x2="13" y2="15"/></svg>
      Reports
    </a>
  </nav>

 
</aside>

<!-- ── MAIN ── -->
<div class="main">

  <!-- Topbar -->
  <header class="topbar">
    <div class="topbar-action" data-popover-wrap>
      <div class="topbar-icon" data-popover-toggle="alerts">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        <span class="badge badge-indigo" data-etubig-alert-badge>0</span>
      </div>
      <div class="topbar-popover" data-popover-id="alerts">
        <div class="popover-title">Notifications</div>
        <ul class="popover-list" data-etubig-notifications></ul>
      </div>
    </div>

    <div class="topbar-action" data-popover-wrap>
      <div class="avatar" data-popover-toggle="admin">A</div>
      <div class="topbar-popover avatar-panel" data-popover-id="admin">
        <div class="avatar-head">
          <div class="avatar-chip" data-etubig-user-chip>A</div>
          <div class="avatar-meta">
            <strong data-etubig-user-name>Admin User</strong>
            <span data-etubig-user-email>admin@etubig.local</span>
          </div>
        </div>
        <div class="avatar-actions">
          <a href="/settings">Account Settings</a>
          <a href="/reports">View Reports</a>
          <a href="/logout">Sign Out</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Content -->
  <div class="content">

    <div class="greeting-row">
      <p class="greeting">
        Hey <%= etubig.greetingName %> &nbsp;–&nbsp; <span>here's what's happening with the water today</span>
      </p>
      <div class="history-wrap" data-history-wrap>
        <button type="button" id="historyToggle" class="history-btn" aria-expanded="false" aria-controls="historyMenu">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 7h18"></path>
            <path d="M3 12h18"></path>
            <path d="M3 17h18"></path>
            <circle cx="7" cy="7" r="1.5"></circle>
            <circle cx="12" cy="12" r="1.5"></circle>
            <circle cx="17" cy="17" r="1.5"></circle>
          </svg>
          Water Quality Scan History
        </button>
        <div id="historyMenu" class="history-menu" role="menu" aria-label="Recent IoT water quality scans"></div>
      </div>
    </div>

    <!-- Water Quality + Potability -->
    <div class="charts-row">
      <div class="metric-grid">
        <div class="metric-card">
          <div class="metric-label">pH Level</div>
          <div class="metric-value"><%= etubig.metrics.ph != null ? etubig.metrics.ph : "—" %><span class="metric-unit">pH</span></div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Turbidity</div>
          <div class="metric-value"><%= etubig.metrics.turbidity != null ? etubig.metrics.turbidity : "—" %><span class="metric-unit">NTU</span></div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Temperature</div>
          <div class="metric-value"><%= etubig.metrics.temperature != null ? etubig.metrics.temperature : "—" %><span class="metric-unit">°C</span></div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Ammonia</div>
          <div class="metric-value"><%= etubig.metrics.ammonia != null ? etubig.metrics.ammonia : "—" %><span class="metric-unit">mg/L</span></div>
        </div>
      </div>

      <div class="potability-card">
        <div class="potability-title">Potability Status</div>
        <div class="potability-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
            <rect x="4" y="4" width="56" height="56" rx="8" fill="#e8f4fb" stroke="#1a8fc1" stroke-width="3"/>
            <polyline points="18,34 28,44 48,22" stroke="#1a8fc1" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="potability-status"><%= etubig.potability %></div>
        <div class="potability-bar"></div>
      </div>
    </div>

    <!-- Water Consumption + Flow Rate -->
    <div class="consumption-row">
      <div class="chart-card-full">
        <div class="chart-header">
          <span class="chart-title">Water Consumption Reports</span>
          <button class="period-btn active" onclick="switchPeriod(this,'consumption','12m')">12 Months</button>
          <button class="period-btn" onclick="switchPeriod(this,'consumption','6m')">6 Months</button>
          <button class="period-btn" onclick="switchPeriod(this,'consumption','30d')">30 Days</button>
          <button class="period-btn" onclick="switchPeriod(this,'consumption','7d')">7 Days</button>
        </div>
        <div class="chart-wrap-full">
          <canvas id="consumptionChart"></canvas>
        </div>
      </div>

      <div class="metric-card flow-side-card">
        <div class="metric-label">Flow Rate</div>
        <div class="metric-value"><%= etubig.metrics.flow != null ? etubig.metrics.flow : "—" %><span class="metric-unit">L/min</span></div>
      </div>
    </div>

  </div>
</div>

<%- include('partials/etubig-data') %>
<script src="/js/etubig-ui.js"></script>
<script>
  // ── Chart data sets ──
  const months12 = ['Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan'];
  const months6  = ['Aug','Sep','Oct','Nov','Dec','Jan'];
  const days30   = Array.from({length:30},(_,i)=>`D${i+1}`);
  const days7    = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];

  const consumptionData = ETUBIG.consumptionData || {};
  const defaultConsumptionPeriod = ETUBIG.defaultConsumptionPeriod || '7d';

  function normalizePeriod(data) {
    if (!data) return { labels: [], datasets: [[0]] };
    return {
      labels: data.labels || [],
      datasets: data.datasets || data.d || [[]],
    };
  }

  function makeDatasets(data) {
    const block = normalizePeriod(data);
    const colors = [
      { line: '#2d3ac8', fill: 'rgba(45,58,200,0.12)' },
      { line: '#6b8cff', fill: 'rgba(107,140,255,0.10)' },
      { line: '#a5b4fc', fill: 'rgba(165,180,252,0.08)' },
    ];
    return block.datasets.map((d, i) => ({
      data: d,
      borderColor: colors[i].line,
      backgroundColor: colors[i].fill,
      fill: true,
      tension: 0.5,
      borderWidth: i === 0 ? 2.5 : 1.5,
      pointRadius: 0,
    }));
  }

  const chartDefaults = {
    type: 'line',
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: '#9aa3af', font: { size: 11 } } },
        y: {
          display: true,
          beginAtZero: true,
          grid: { color: '#eef2f7' },
          ticks: {
            color: '#9aa3af',
            font: { size: 11 },
            precision: 0
          }
        },
      },
      interaction: { mode: 'nearest', axis: 'x', intersect: false },
    }
  };

  // Init charts
  const cCtx = document.getElementById('consumptionChart').getContext('2d');

  const consumptionStart = normalizePeriod(
    consumptionData[defaultConsumptionPeriod] || consumptionData['7d'] || consumptionData['12m']
  );
  const consumptionChart = new Chart(cCtx, {
    ...chartDefaults,
    data: { labels: consumptionStart.labels, datasets: makeDatasets(consumptionStart) },
  });

  document.querySelectorAll('.chart-card-full .period-btn').forEach((btn) => {
    const match = btn.getAttribute('onclick')?.includes(`'${defaultConsumptionPeriod}'`);
    btn.classList.toggle('active', !!match);
  });

  const charts = { consumption: consumptionChart };
  const dataMap = { consumption: consumptionData };
  const historyToggle = document.getElementById('historyToggle');
  const historyMenu = document.getElementById('historyMenu');

  function switchPeriod(btn, chartKey, period) {
    // Update button styles in same group
    btn.closest('.chart-header').querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const chart = charts[chartKey];
    const d = normalizePeriod(dataMap[chartKey][period]);
    if (!d.labels.length && !d.datasets[0]?.length) return;
    chart.data.labels = d.labels;
    chart.data.datasets = makeDatasets(d);
    chart.update();
  }

  const scanHistory = ETUBIG.scanHistory || [];

  function renderScanHistory() {
    if (!historyMenu) return;
    historyMenu.innerHTML = scanHistory
      .map((scan) => `
        <div class="history-item">
          <div class="history-item-head">
            <span>${scan.timestamp}</span>
            <span>${scan.source}</span>
          </div>
          <div class="history-item-metrics">
            pH ${(scan.ph ?? 0).toFixed(1)} | Turbidity ${(scan.turbidity ?? 0).toFixed(1)} NTU | Temp ${scan.temperature ?? '—'}°C | Flow ${scan.flow ?? '—'} L/min
          </div>
        </div>
      `)
      .join('');
  }

  renderScanHistory();

  // Topbar popovers (notification + admin profile)
  const popovers = document.querySelectorAll('[data-popover-id]');
  const toggles = document.querySelectorAll('[data-popover-toggle]');

  function closeAllPopovers() {
    popovers.forEach((popover) => popover.classList.remove('show'));
  }

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      const targetId = toggle.getAttribute('data-popover-toggle');
      const targetPopover = document.querySelector(`[data-popover-id="${targetId}"]`);
      const isOpen = targetPopover && targetPopover.classList.contains('show');
      closeAllPopovers();
      if (targetPopover && !isOpen) targetPopover.classList.add('show');
    });
  });

  if (historyToggle && historyMenu) {
    historyToggle.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const isOpen = historyMenu.classList.contains('show');
      historyMenu.classList.toggle('show', !isOpen);
      historyToggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  document.addEventListener('click', (event) => {
    if (!event.target.closest('[data-popover-wrap]')) {
      closeAllPopovers();
    }
    if (!event.target.closest('[data-history-wrap]') && historyMenu && historyToggle) {
      historyMenu.classList.remove('show');
      historyToggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>

</body>
</html>
