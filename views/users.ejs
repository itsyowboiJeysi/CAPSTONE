<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Tubig | Manage Users</title>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', sans-serif; background: #f4f6f9; color: #1a1a2e; display: flex; min-height: 100vh; }
    .sidebar { width: 210px; min-height: 100vh; background: #fff; border-right: 1px solid #e8ecf0; position: fixed; top: 0; left: 0; bottom: 0; z-index: 100; }
    .sidebar-brand { display: flex; align-items: center; gap: 8px; padding: 1.3rem 1.4rem; color: #1a8fc1; font-weight: 700; font-size: 16px; border-bottom: 1px solid #f0f4f8; }
    .sidebar-nav { padding: 1rem 0; display: flex; flex-direction: column; gap: 2px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 1.4rem; font-size: 14px; color: #6b7280; text-decoration: none; }
    .nav-item:hover, .nav-item.active { background: #e8f4fb; color: #1a8fc1; font-weight: 600; }
    .main { margin-left: 210px; flex: 1; padding: 1.8rem 2rem; }
    h1 { font-size: 1.5rem; margin-bottom: .35rem; }
    .subtitle { color: #6b7280; font-size: 14px; margin-bottom: 1.25rem; }
    .flash { padding: 10px 14px; border-radius: 8px; margin-bottom: 1rem; font-size: 14px; }
    .flash.ok { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .flash.err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
    .grid { display: grid; grid-template-columns: 340px 1fr; gap: 1.5rem; align-items: start; }
    @media (max-width: 960px) { .grid { grid-template-columns: 1fr; } }
    .card { background: #fff; border: 1px solid #e8ecf0; border-radius: 12px; padding: 1.25rem; }
    .card h2 { font-size: 1rem; margin-bottom: 1rem; }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #374151; }
    input, select { width: 100%; border: 1px solid #d1d5db; border-radius: 8px; padding: 9px 12px; font-size: 14px; margin-bottom: 12px; }
    .check-row { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .check-row input { width: auto; margin: 0; }
    .btn { background: #1a8fc1; color: #fff; border: none; border-radius: 8px; padding: 10px 16px; font-weight: 600; cursor: pointer; width: 100%; }
    .btn:hover { background: #1576a3; }
    .btn-sm { width: auto; padding: 6px 10px; font-size: 12px; }
    .btn-danger { background: #dc2626; }
    .btn-danger:hover { background: #b91c1c; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #f0f4f8; vertical-align: top; }
    th { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: .04em; }
    .pill { display: inline-block; padding: 3px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .pill.admin { background: #dbeafe; color: #1d4ed8; }
    .pill.operator { background: #e0f2fe; color: #0369a1; }
    .pill.viewer { background: #f3f4f6; color: #4b5563; }
    .pill.off { background: #fee2e2; color: #b91c1c; }
    .pill.on { background: #d1fae5; color: #047857; }
    details { margin-top: 4px; }
    summary { cursor: pointer; color: #1a8fc1; font-size: 13px; }
    .row-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
  </style>
</head>
<body>
<aside class="sidebar">
  <div class="sidebar-brand">E-Tubig</div>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="nav-item">Dashboard</a>
    <a href="/monitoring" class="nav-item">Real-Time Monitoring</a>
    <a href="/water-quality" class="nav-item">Water Quality</a>
    <a href="/consumption" class="nav-item">Consumption</a>
    <a href="/alerts" class="nav-item">Alerts</a>
    <a href="/history" class="nav-item">History/Logs</a>
    <a href="/reports" class="nav-item">Reports</a>
    <a href="/users" class="nav-item active">Manage Users</a>
    <a href="/logout" class="nav-item">Sign Out</a>
  </nav>
</aside>

<main class="main">
  <h1>Manage Users</h1>
  <p class="subtitle">Add accounts, assign roles, and control access to E-Tubig.</p>

  <% if (message) { %><div class="flash ok"><%= message %></div><% } %>
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>

  <div class="grid">
    <section class="card">
      <h2>Add user</h2>
      <form method="POST" action="/users">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="name@example.com" />

        <label for="full_name">Full name</label>
        <input type="text" id="full_name" name="full_name" required placeholder="Juan Dela Cruz" />

        <label for="role">Role</label>
        <select id="role" name="role">
          <option value="admin">Admin</option>
          <option value="operator" selected>Operator</option>
          <option value="viewer">Viewer</option>
        </select>

        <label for="password">Password</label>
        <input type="password" id="password" name="password" required minlength="6" />

        <div class="check-row">
          <input type="checkbox" id="is_active" name="is_active" checked />
          <label for="is_active" style="margin:0;font-weight:400;">Active account</label>
        </div>

        <button type="submit" class="btn">Add user</button>
      </form>
    </section>

    <section class="card">
      <h2>All users (<%= users.length %>)</h2>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
          <tr>
            <td><%= u.full_name %></td>
            <td><%= u.email %></td>
            <td><span class="pill <%= u.role %>"><%= u.role %></span></td>
            <td>
              <% if (u.is_active) { %>
                <span class="pill on">Active</span>
              <% } else { %>
                <span class="pill off">Inactive</span>
              <% } %>
            </td>
            <td>
              <details>
                <summary>Edit</summary>
                <form method="POST" action="/users/<%= u.id %>/update" style="margin-top:10px;">
                  <label>Email</label>
                  <input type="email" name="email" value="<%= u.email %>" required />
                  <label>Full name</label>
                  <input type="text" name="full_name" value="<%= u.full_name %>" required />
                  <label>Role</label>
                  <select name="role">
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    <option value="operator" <%= u.role === 'operator' ? 'selected' : '' %>>Operator</option>
                    <option value="viewer" <%= u.role === 'viewer' ? 'selected' : '' %>>Viewer</option>
                  </select>
                  <label>New password (leave blank to keep)</label>
                  <input type="password" name="password" minlength="6" placeholder="Optional" />
                  <div class="check-row">
                    <input type="checkbox" name="is_active" id="active_<%= u.id %>" <%= u.is_active ? 'checked' : '' %> />
                    <label for="active_<%= u.id %>" style="margin:0;font-weight:400;">Active</label>
                  </div>
                  <div class="row-actions">
                    <button type="submit" class="btn btn-sm">Save</button>
                  </div>
                </form>
                <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.id !== u.id) { %>
                <form method="POST" action="/users/<%= u.id %>/delete" onsubmit="return confirm('Delete this user?');">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
                <% } %>
              </details>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </div>
</main>
</body>
</html>
