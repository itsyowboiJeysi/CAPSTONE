<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Tubig | Reports</title>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    html::-webkit-scrollbar,
    body::-webkit-scrollbar,
    .main::-webkit-scrollbar,
    .content::-webkit-scrollbar,
    .sidebar::-webkit-scrollbar { display: none; }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 210px;
      min-height: 100vh;
      background: #fff;
      border-right: 1px solid #e8ecf0;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 100;
      overflow-y: auto;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 1.3rem 1.4rem;
      color: #1a8fc1;
      font-weight: 700;
      font-size: 16px;
      border-bottom: 1px solid #f0f4f8;
    }
    .sidebar-nav {
      flex: 1;
      padding: 1rem 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 1.4rem;
      font-size: 14px;
      color: #6b7280;
      text-decoration: none;
      transition: background .15s, color .15s;
    }
    .nav-item:hover { background: #f0f7fb; color: #1a8fc1; }
    .nav-item.active {
      background: #e8f4fb;
      color: #1a8fc1;
      font-weight: 600;
      border-right: 3px solid #1a8fc1;
    }
    .nav-item svg { width: 17px; height: 17px; flex-shrink: 0; }
    .sidebar-bottom {
      padding: 1rem 0;
      border-top: 1px solid #f0f4f8;
    }

    .main {
      margin-left: 210px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .topbar {
      background: #fff;
      border-bottom: 1px solid #e8ecf0;
      padding: .75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .topbar-icon {
      position: relative;
      width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%;
      background: #f4f6f9;
      cursor: pointer;
      color: #6b7280;
    }
    .topbar-icon:hover { background: #e8f4fb; color: #1a8fc1; }
    .topbar-action { position: relative; }
    .badge {
      position: absolute;
      top: -2px; right: -2px;
      width: 17px; height: 17px;
      border-radius: 50%;
      font-size: 10px;
      font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      color: #fff;
      background: #5b5fcf;
    }
    .avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: #cbd5e0;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; color: #fff; font-size: 14px;
      cursor: pointer;
    }
    .topbar-popover {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 290px;
      background: #fff;
      border: 1px solid #e8ecf0;
      border-radius: 12px;
      box-shadow: 0 14px 30px rgba(26, 35, 56, 0.12);
      padding: .8rem;
      display: none;
      z-index: 80;
    }
    .topbar-popover.show { display: block; }
    .popover-title { font-size: 13px; font-weight: 700; margin-bottom: .65rem; }
    .popover-list { list-style: none; display: flex; flex-direction: column; gap: .45rem; }
    .popover-item {
      border: 1px solid #eef2f7;
      border-radius: 8px;
      padding: .55rem .65rem;
      background: #f9fbfd;
    }
    .popover-item strong { display: block; font-size: 12px; margin-bottom: 2px; }
    .popover-item span { font-size: 12px; color: #6b7280; }

    .avatar-panel { width: 250px; }
    .avatar-head {
      display: flex;
      align-items: center;
      gap: .65rem;
      margin-bottom: .65rem;
      padding-bottom: .65rem;
      border-bottom: 1px solid #eef2f7;
    }
    .avatar-chip {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: #1a8fc1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
    }
    .avatar-meta strong { display: block; font-size: 13px; }
    .avatar-meta span { font-size: 12px; color: #6b7280; }
    .avatar-actions { display: flex; flex-direction: column; gap: .35rem; }
    .avatar-actions a { text-decoration: none; font-size: 12px; color: #1a8fc1; font-weight: 600; }

    .content { padding: 1.6rem 2rem; flex: 1; }
    .header-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 1rem;
      gap: 1rem;
    }
    .page-title { font-size: 30px; font-weight: 700; }
    .page-subtitle { font-size: 20px; color: #5f6b7a; }

    .reports-layout {
      display: grid;
      grid-template-columns: minmax(280px, 320px) 1fr;
      gap: 1rem;
    }
    .card {
      background: #fff;
      border: 1.5px solid #c8e6f5;
      border-radius: 14px;
      padding: 1rem;
    }
    .panel-title { font-size: 14px; font-weight: 700; margin-bottom: .7rem; }
    .data-list { display: flex; flex-direction: column; gap: .5rem; }
    .device-picker { position: relative; }

    .reports-history-wrap { position: relative; width: 100%; }
    .reports-history-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      justify-content: flex-start;
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 600;
      color: #0f2942;
      background: rgba(255, 255, 255, 0.55);
      border: 1px solid rgba(26, 143, 193, 0.28);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      cursor: pointer;
      transition: background .15s, border-color .15s, color .15s;
      font-family: inherit;
    }
    .reports-history-btn:hover {
      background: rgba(255, 255, 255, 0.8);
      border-color: rgba(26, 143, 193, 0.5);
      color: #065a73;
    }
    .reports-history-btn svg { flex-shrink: 0; }
    .reports-history-panel {
      display: none;
      margin-top: 10px;
      padding: 10px;
      border-radius: 12px;
      background: rgba(238, 248, 254, 0.72);
      border: 1px solid rgba(200, 230, 245, 0.95);
      box-shadow: 0 10px 22px rgba(0, 30, 50, 0.1);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .reports-history-panel.show { display: block; }
    .reports-history-segments {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
    }
    .reports-history-seg {
      flex: 1;
      border: 1px solid rgba(26, 143, 193, 0.25);
      background: rgba(255, 255, 255, 0.45);
      border-radius: 8px;
      padding: 6px 8px;
      font-size: 11px;
      font-weight: 600;
      color: #2d5268;
      cursor: pointer;
      font-family: inherit;
      transition: background .12s, border-color .12s;
    }
    .reports-history-seg.active {
      background: rgba(26, 143, 193, 0.15);
      border-color: rgba(26, 143, 193, 0.45);
      color: #0f2942;
    }
    .reports-history-list {
      max-height: 240px;
      overflow-y: auto;
      margin-bottom: 10px;
    }
    .reports-history-item {
      background: rgba(255, 255, 255, 0.5);
      border: 1px solid rgba(200, 226, 240, 0.9);
      border-radius: 9px;
      padding: 8px 10px;
      margin-bottom: 8px;
      color: #142434;
    }
    .reports-history-item:last-child { margin-bottom: 0; }
    .reports-history-item.draggable-row {
      cursor: grab;
      user-select: none;
    }
    .reports-history-item.draggable-row:active { cursor: grabbing; }
    .reports-history-item-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      color: #4f6171;
      margin-bottom: 4px;
    }
    .reports-history-item-metrics {
      font-size: 11px;
      line-height: 1.45;
      color: #0d2438;
      font-weight: 600;
    }
    .reports-history-drag-strip {
      font-size: 11px;
      font-weight: 600;
      color: #154a61;
      text-align: center;
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px dashed rgba(26, 143, 193, 0.45);
      background: rgba(232, 244, 251, 0.65);
      cursor: grab;
      user-select: none;
    }
    .reports-history-drag-strip:active { cursor: grabbing; }
    .device-menu {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid #d7dde5;
      border-radius: 8px;
      box-shadow: 0 10px 20px rgba(26, 35, 56, 0.12);
      display: none;
      z-index: 90;
      overflow: hidden;
    }
    .device-menu.show { display: block; }
    .device-option {
      width: 100%;
      border: none;
      background: #fff;
      text-align: left;
      padding: 8px 10px;
      font-size: 12px;
      color: #2d3748;
      cursor: pointer;
      font-family: inherit;
    }
    .device-option:hover { background: #f0f7fb; color: #1a8fc1; }
    .snapshot-controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: .4rem;
      margin-bottom: .1rem;
    }
    .snapshot-controls input {
      width: 100%;
      border: 1px solid #d7dde5;
      border-radius: 7px;
      padding: 6px 8px;
      font-size: 12px;
      color: #2d3748;
      font-family: inherit;
      outline: none;
      background: #fff;
    }
    .helper { font-size: 11px; color: #6b7280; margin-top: .65rem; line-height: 1.4; }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: .75rem;
      margin-bottom: .75rem;
    }
    .field label { display: block; font-size: 11px; color: #718096; margin-bottom: 4px; }
    .field input, .field select {
      width: 100%;
      border: 1px solid #d7dde5;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 13px;
      outline: none;
      font-family: inherit;
    }

    .toolbar {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      border: 1px solid #d7dde5;
      border-radius: 10px 10px 0 0;
      border-bottom: none;
      padding: .55rem;
      background: #f9fbfd;
    }
    .tool-btn {
      border: 1px solid #d7dde5;
      background: #fff;
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 12px;
      cursor: pointer;
      color: #4a5568;
    }
    .editor {
      min-height: 320px;
      border: 1px solid #d7dde5;
      border-radius: 0 0 10px 10px;
      background: #fff;
      padding: .9rem;
      outline: none;
      font-size: 14px;
      line-height: 1.5;
    }
    .editor.drop-target { border-color: #1a8fc1; background: #f2faff; }
    .report-record-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: .65rem;
      border: 1px solid #d7dde5;
      border-radius: 8px;
      overflow: hidden;
    }
    .report-record-table th,
    .report-record-table td {
      border-bottom: 1px solid #e7edf3;
      padding: 8px 10px;
      font-size: 12px;
      text-align: left;
    }
    .report-record-table th {
      background: #f4f8fc;
      color: #607084;
      font-weight: 700;
      letter-spacing: .2px;
    }
    .report-record-table tr:last-child td {
      border-bottom: none;
    }

    .actions {
      margin-top: .8rem;
      display: flex;
      justify-content: flex-end;
      gap: .55rem;
    }
    .btn {
      border: 1px solid #d7dde5;
      background: #fff;
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 12px;
      cursor: pointer;
      color: #4a5568;
      font-weight: 600;
    }
    .btn.primary {
      border-color: #1a8fc1;
      background: #1a8fc1;
      color: #fff;
    }
  <%- include('partials/glass-app-theme') %>
  </style>
</head>
<body>
<aside class="sidebar">
  <div class="sidebar-brand">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M12 2L4 9v11h5v-6h6v6h5V9z" fill="#1a8fc1"/>
      <polygon points="12,2 20,9 4,9" fill="#29b6d1"/>
    </svg>
    E-Tubig
  </div>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>Dashboard</a>
    <a href="/monitoring" class="nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>Real-Time Monitoring</a>
    <a href="/water-quality" class="nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6 9 4 13 4 16a8 8 0 0016 0c0-3-2-7-8-14z"/></svg>Water Quality</a>
    <a href="/consumption" class="nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>Consumption</a>
    <a href="/alerts" class="nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>Alerts</a>
    <a href="/history" class="nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h18"/><rect x="2" y="3" width="4" height="4" rx="1"/><rect x="2" y="10" width="4" height="4" rx="1"/><rect x="2" y="17" width="4" height="4" rx="1"/></svg>History/Logs</a>
    <a href="/reports" class="nav-item active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="9" y1="7" x2="15" y2="7"/><line x1="9" y1="11" x2="15" y2="11"/><line x1="9" y1="15" x2="13" y2="15"/></svg>Reports</a>
  </nav>
 
</aside>

<div class="main">
  <header class="topbar">
    <div class="topbar-action" data-popover-wrap>
      <div class="topbar-icon" data-popover-toggle="alerts">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        <span class="badge" data-etubig-alert-badge>0</span>
      </div>
      <div class="topbar-popover" data-popover-id="alerts">
        <div class="popover-title">Notifications</div>
        <ul class="popover-list" data-etubig-notifications></ul>
      </div>
    </div>
    <div class="topbar-action" data-popover-wrap>
      <div class="avatar" data-popover-toggle="admin">A</div>
      <div class="topbar-popover avatar-panel" data-popover-id="admin">
        <div class="avatar-head">
          <div class="avatar-chip" data-etubig-user-chip>A</div>
          <div class="avatar-meta"><strong data-etubig-user-name>Admin User</strong><span data-etubig-user-email>admin@etubig.local</span></div>
        </div>
        <div class="avatar-actions">
          <a href="/settings">Account Settings</a>
          <a href="/reports">View Reports</a>
          <a href="/logout">Sign Out</a>
        </div>
      </div>
    </div>
  </header>

  <div class="content">
    <div class="header-row">
      <div>
        <h1 class="page-title">Reports</h1>
        <p class="page-subtitle">Create analysis reports and export to PDF</p>
      </div>
    </div>

    <div class="reports-layout">
      <div class="card">
        <div class="panel-title">Sensor history</div>
        <div class="data-list">
          <div class="reports-history-wrap" data-reports-history-wrap>
            <button type="button" id="reportsHistoryToggle" class="reports-history-btn" aria-expanded="false" aria-controls="reportsHistoryPanel">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 7h18"></path>
                <path d="M3 12h18"></path>
                <path d="M3 17h18"></path>
                <circle cx="7" cy="7" r="1.5"></circle>
                <circle cx="12" cy="12" r="1.5"></circle>
                <circle cx="17" cy="17" r="1.5"></circle>
              </svg>
              Water Quality &amp; Flow History
            </button>
            <div id="reportsHistoryPanel" class="reports-history-panel" role="region" aria-label="IoT readings for reports">
              <div class="reports-history-segments">
                <button type="button" class="reports-history-seg active" data-history-type="quality">Water quality</button>
                <button type="button" class="reports-history-seg" data-history-type="flow">Flow rate</button>
              </div>
              <div id="reportsHistoryList" class="reports-history-list"></div>
              <div draggable="true" id="reportsHistoryDragStrip" class="reports-history-drag-strip" title="Drag into report editor">
                Drag into report · insert readings above as a table
              </div>
            </div>
          </div>
        </div>
        <p class="helper">Same layout as Dashboard. Drag any row into the report for a single-line insert, or use the dashed bar at the bottom of the panel for all rows.</p>
      </div>

      <div class="card" data-reports-work-area>
        <div class="form-grid">
          <div class="field">
            <label for="reportTitle">Report Title</label>
            <input id="reportTitle" type="text" value="Water Quality and Consumption Analysis Report" />
          </div>
          <div class="field">
            <label for="reportType">Report Type</label>
            <select id="reportType">
              <option>Daily Summary</option>
              <option>Weekly Analysis</option>
              <option>Monthly Compliance</option>
            </select>
          </div>
          <div class="field">
            <label for="reportDate">Report Date</label>
            <input id="reportDate" type="date" />
          </div>
        </div>

        <div class="toolbar">
          <button class="tool-btn" type="button" data-cmd="bold"><b>B</b></button>
          <button class="tool-btn" type="button" data-cmd="italic"><i>I</i></button>
          <button class="tool-btn" type="button" data-cmd="underline"><u>U</u></button>
          <button class="tool-btn" type="button" data-cmd="insertUnorderedList">• List</button>
          <button class="tool-btn" type="button" data-cmd="insertOrderedList">1. List</button>
          <button class="tool-btn" type="button" data-cmd="justifyLeft">Left</button>
          <button class="tool-btn" type="button" data-cmd="justifyCenter">Center</button>
          <button class="tool-btn" type="button" data-cmd="justifyRight">Right</button>
        </div>
        <div id="reportEditor" class="editor" contenteditable="true">
          <h3>Executive Summary</h3>
          <p>Open <strong>Water Quality &amp; Flow History</strong> on the left to preview readings.</p>
          <p>Drag any reading row into this area for one row, or drag the dashed bar in the panel to insert the full table.</p>
        </div>

        <div class="actions">
          <button class="btn" id="clearReportBtn" type="button">Clear</button>
          <button class="btn primary" id="exportPdfBtn" type="button">Export to PDF</button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/etubig-data') %>
<script src="/js/etubig-ui.js"></script>
<script>
  document.getElementById('reportDate').valueAsDate = new Date();

  const popovers = document.querySelectorAll('[data-popover-id]');
  const toggles = document.querySelectorAll('[data-popover-toggle]');
  function closeAllPopovers() { popovers.forEach((p) => p.classList.remove('show')); }
  toggles.forEach((toggle) => {
    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      const targetPopover = document.querySelector(`[data-popover-id="${toggle.getAttribute('data-popover-toggle')}"]`);
      const isOpen = targetPopover && targetPopover.classList.contains('show');
      closeAllPopovers();
      if (targetPopover && !isOpen) targetPopover.classList.add('show');
    });
  });
  const editor = document.getElementById('reportEditor');
  const reportsHistoryToggle = document.getElementById('reportsHistoryToggle');
  const reportsHistoryPanel = document.getElementById('reportsHistoryPanel');
  const reportsHistoryList = document.getElementById('reportsHistoryList');
  const reportsHistoryDragStrip = document.getElementById('reportsHistoryDragStrip');
  const deviceProfiles = ETUBIG.deviceProfiles || {};
  let selectedHistoryType = 'quality';

  function getAggregatedRows() {
    return Object.entries(deviceProfiles)
      .flatMap(([deviceName, profile]) =>
        (profile.history || []).map((entry) => ({ ...entry, deviceName }))
      )
      .sort((a, b) => new Date(b.iso) - new Date(a.iso));
  }

  function formatFlowCell(entry) {
    const flowNum = typeof entry.flow === 'string'
      ? parseFloat(entry.flow.replace(/[^\d.]/g, ''))
      : Number(entry.flow);
    return Number.isFinite(flowNum)
      ? `${flowNum.toFixed(2)} L/min`
      : (entry.flow || '—');
  }

  function renderReportsHistoryPreview() {
    if (!reportsHistoryList) return;
    const rows = getAggregatedRows();
    const preview = rows.slice(0, 12);
    if (!preview.length) {
      reportsHistoryList.innerHTML = '<div class="reports-history-item"><div class="reports-history-item-metrics">No history rows available.</div></div>';
      return;
    }
    const histTypeAttr = selectedHistoryType === 'flow' ? 'flow' : 'quality';
    reportsHistoryList.innerHTML = preview.map((entry, indexInFullList) => {
      if (selectedHistoryType === 'flow') {
        return `
          <div class="reports-history-item draggable-row" draggable="true" data-history-index="${indexInFullList}" data-history-type="${histTypeAttr}">
            <div class="reports-history-item-head">
              <span>${entry.timestamp}</span>
              <span>${entry.deviceName}</span>
            </div>
            <div class="reports-history-item-metrics">
              Flow ${formatFlowCell(entry)}
            </div>
          </div>
        `;
      }
      return `
        <div class="reports-history-item draggable-row" draggable="true" data-history-index="${indexInFullList}" data-history-type="${histTypeAttr}">
          <div class="reports-history-item-head">
            <span>${entry.timestamp}</span>
            <span>${entry.deviceName}</span>
          </div>
          <div class="reports-history-item-metrics">
            ${entry.ph} | ${entry.turbidity} | ${entry.temperature} | Flow ${formatFlowCell(entry)}
          </div>
        </div>
      `;
    }).join('');
  }

  function ensureReportTable(type) {
    const tableClass = type === 'flow' ? 'report-record-table report-flow-table' : 'report-record-table report-quality-table';
    const selector = type === 'flow' ? '.report-flow-table' : '.report-quality-table';
    let table = editor.querySelector(selector);
    if (table) return table;

    const tableHtml = type === 'flow'
      ? `
      <table class="${tableClass}">
        <thead>
          <tr>
            <th>Date / Time</th>
            <th>Device</th>
            <th>Flow Rate (L/min)</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    `
      : `
      <table class="${tableClass}">
        <thead>
          <tr>
            <th>Date / Time</th>
            <th>Device</th>
            <th>pH</th>
            <th>Turbidity</th>
            <th>Temperature</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    `;
    editor.insertAdjacentHTML('beforeend', tableHtml);
    return editor.querySelector(selector);
  }

  function appendSingleHistoryRow(entry, typeOverride) {
    const t = typeOverride === 'flow' ? 'flow' : 'quality';
    const table = ensureReportTable(t);
    const tbody = table.querySelector('tbody');
    const flowCell = formatFlowCell(entry);
    const row = document.createElement('tr');
    row.innerHTML = t === 'flow'
      ? `
        <td>${entry.timestamp}</td>
        <td>${entry.deviceName}</td>
        <td>${flowCell}</td>
      `
      : `
        <td>${entry.timestamp}</td>
        <td>${entry.deviceName}</td>
        <td>${entry.ph}</td>
        <td>${entry.turbidity}</td>
        <td>${entry.temperature}</td>
        <td>${entry.status}</td>
      `;
    tbody.appendChild(row);
  }

  function appendHistoryRows() {
    const rows = getAggregatedRows();
    if (!rows.length) return;

    const table = ensureReportTable(selectedHistoryType);
    const tbody = table.querySelector('tbody');
    tbody.innerHTML = '';

    rows.forEach((entry) => {
      appendSingleHistoryRow(entry, selectedHistoryType);
    });
  }

  if (reportsHistoryToggle && reportsHistoryPanel) {
    reportsHistoryToggle.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const isOpen = reportsHistoryPanel.classList.contains('show');
      reportsHistoryPanel.classList.toggle('show', !isOpen);
      reportsHistoryToggle.setAttribute('aria-expanded', String(!isOpen));
      if (!isOpen) renderReportsHistoryPreview();
    });
  }

  document.querySelectorAll('.reports-history-seg').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      document.querySelectorAll('.reports-history-seg').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedHistoryType = btn.getAttribute('data-history-type') || 'quality';
      if (reportsHistoryPanel && reportsHistoryPanel.classList.contains('show')) {
        renderReportsHistoryPreview();
      }
    });
  });

  if (reportsHistoryDragStrip) {
    reportsHistoryDragStrip.addEventListener('dragstart', (event) => {
      event.stopPropagation();
      event.dataTransfer.setData('text/plain', 'HISTORY_BLOCK');
      event.dataTransfer.setData('application/x-report-field', 'historyType');
      event.dataTransfer.effectAllowed = 'copy';
    });
  }

  if (reportsHistoryList) {
    reportsHistoryList.addEventListener('dragstart', (event) => {
      const el = event.target.closest('.reports-history-item[data-history-index]');
      if (!el) return;
      const idx = parseInt(el.getAttribute('data-history-index'), 10);
      const rowType = el.getAttribute('data-history-type') === 'flow' ? 'flow' : 'quality';
      if (Number.isNaN(idx)) return;
      event.stopPropagation();
      event.dataTransfer.setData('application/x-report-history-row', JSON.stringify({ index: idx, type: rowType }));
      event.dataTransfer.setData('text/plain', 'report-history-row');
      event.dataTransfer.effectAllowed = 'copy';
    });
  }

  let editorDragDepth = 0;
  editor.addEventListener('dragenter', (event) => {
    event.preventDefault();
    editorDragDepth += 1;
    editor.classList.add('drop-target');
  });
  editor.addEventListener('dragover', (event) => {
    event.preventDefault();
  });
  editor.addEventListener('dragleave', (event) => {
    event.preventDefault();
    editorDragDepth -= 1;
    if (editorDragDepth <= 0) {
      editorDragDepth = 0;
      editor.classList.remove('drop-target');
    }
  });

  editor.addEventListener('click', () => editor.focus());

  editor.addEventListener('drop', (event) => {
    event.preventDefault();
    editorDragDepth = 0;
    editor.classList.remove('drop-target');

    const rowPayload = event.dataTransfer.getData('application/x-report-history-row');
    if (rowPayload) {
      try {
        const parsed = JSON.parse(rowPayload);
        const idx = Number.isFinite(parsed.index) ? parsed.index : parseInt(parsed.index, 10);
        const rowType = parsed.type === 'flow' ? 'flow' : 'quality';
        const rows = getAggregatedRows();
        const entry = rows[idx];
        if (entry) appendSingleHistoryRow(entry, rowType);
      } catch (_) { /* ignore malformed payload */ }
      editor.focus({ preventScroll: true });
      return;
    }

    const token = event.dataTransfer.getData('text/plain');
    const field = event.dataTransfer.getData('application/x-report-field');
    if (!token) return;
    if (field === 'historyType' || token === 'HISTORY_BLOCK') {
      appendHistoryRows();
    }
    editor.focus({ preventScroll: true });
  });

  document.addEventListener('dragend', () => {
    editorDragDepth = 0;
    editor.classList.remove('drop-target');
  });

  document.querySelectorAll('[data-cmd]').forEach((btn) => {
    btn.addEventListener('click', () => {
      editor.focus();
      document.execCommand(btn.getAttribute('data-cmd'), false, null);
    });
  });

  document.getElementById('clearReportBtn').addEventListener('click', () => {
    editor.innerHTML = '<p></p>';
    editor.focus();
  });

  document.getElementById('exportPdfBtn').addEventListener('click', () => {
    const title = document.getElementById('reportTitle').value || 'Report';
    const type = document.getElementById('reportType').value || '';
    const date = document.getElementById('reportDate').value || '';
    const content = editor.innerHTML;

    const printWindow = window.open('', '_blank', 'width=900,height=700');
    if (!printWindow) return;
    printWindow.document.write(`
      <html>
      <head>
        <title>${title}</title>
        <style>
          body { font-family: Segoe UI, sans-serif; padding: 28px; color: #111827; }
          h1 { margin-bottom: 8px; font-size: 24px; }
          .meta { margin-bottom: 18px; color: #4b5563; font-size: 13px; }
          .paper { border: 1px solid #e5e7eb; border-radius: 8px; padding: 18px; }
        </style>
      </head>
      <body>
        <h1>${title}</h1>
        <div class="meta">Type: ${type} | Date: ${date}</div>
        <div class="paper">${content}</div>
      </body>
      </html>
    `);
    printWindow.document.close();
    printWindow.focus();
    printWindow.print();
  });

  document.addEventListener('click', (event) => {
    if (!event.target.closest('[data-popover-wrap]')) closeAllPopovers();
    const clickedHistory = event.target.closest('[data-reports-history-wrap]');
    const clickedWorkArea = event.target.closest('[data-reports-work-area]');
    if (!clickedHistory && !clickedWorkArea) {
      if (reportsHistoryPanel && reportsHistoryToggle) {
        reportsHistoryPanel.classList.remove('show');
        reportsHistoryToggle.setAttribute('aria-expanded', 'false');
      }
    }
  });
</script>
</body>
</html>
