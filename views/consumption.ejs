<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Tubig | Consumption</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    html::-webkit-scrollbar,
    body::-webkit-scrollbar,
    .main::-webkit-scrollbar,
    .content::-webkit-scrollbar { display: none; }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      display: flex;
      min-height: 100vh;
    }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 210px;
      min-height: 100vh;
      background: #fff;
      border-right: 1px solid #e8ecf0;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 100;
      overflow-y: auto;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .sidebar::-webkit-scrollbar { display: none; }
    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 1.3rem 1.4rem;
      color: #1a8fc1;
      font-weight: 700;
      font-size: 16px;
      border-bottom: 1px solid #f0f4f8;
    }
    .sidebar-nav {
      flex: 1;
      padding: 1rem 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 1.4rem;
      font-size: 14px;
      color: #6b7280;
      text-decoration: none;
      cursor: pointer;
      transition: background .15s, color .15s;
    }
    .nav-item:hover { background: #f0f7fb; color: #1a8fc1; }
    .nav-item.active {
      background: #e8f4fb;
      color: #1a8fc1;
      font-weight: 600;
      border-right: 3px solid #1a8fc1;
    }
    .nav-item svg { width: 17px; height: 17px; flex-shrink: 0; }
    .sidebar-bottom {
      padding: 1rem 0;
      border-top: 1px solid #f0f4f8;
    }

    /* ── MAIN / TOPBAR ── */
    .main {
      margin-left: 210px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .topbar {
      background: #fff;
      border-bottom: 1px solid #e8ecf0;
      padding: .75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .topbar-icon {
      position: relative;
      width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%;
      background: #f4f6f9;
      cursor: pointer;
      color: #6b7280;
    }
    .topbar-icon:hover { background: #e8f4fb; color: #1a8fc1; }
    .topbar-action { position: relative; }
    .topbar-popover {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 290px;
      background: #fff;
      border: 1px solid #e8ecf0;
      border-radius: 12px;
      box-shadow: 0 14px 30px rgba(26, 35, 56, 0.12);
      padding: .8rem;
      display: none;
      z-index: 80;
    }
    .topbar-popover.show { display: block; }
    .popover-title {
      font-size: 13px;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: .65rem;
    }
    .popover-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .45rem;
    }
    .popover-item {
      border: 1px solid #eef2f7;
      border-radius: 8px;
      padding: .55rem .65rem;
      background: #f9fbfd;
    }
    .popover-item strong {
      display: block;
      font-size: 12px;
      color: #1a1a2e;
      margin-bottom: 2px;
    }
    .popover-item span {
      font-size: 12px;
      color: #6b7280;
      line-height: 1.35;
      display: block;
    }
    .avatar-panel { width: 250px; }
    .avatar-head {
      display: flex;
      align-items: center;
      gap: .65rem;
      margin-bottom: .65rem;
      padding-bottom: .65rem;
      border-bottom: 1px solid #eef2f7;
    }
    .avatar-chip {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #1a8fc1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
    }
    .avatar-meta strong {
      display: block;
      font-size: 13px;
      color: #1a1a2e;
    }
    .avatar-meta span {
      font-size: 12px;
      color: #6b7280;
    }
    .avatar-actions {
      display: flex;
      flex-direction: column;
      gap: .35rem;
    }
    .avatar-actions a {
      text-decoration: none;
      font-size: 12px;
      color: #1a8fc1;
      font-weight: 600;
      padding: 4px 2px;
    }
    .avatar-actions a:hover { color: #157aab; }
    .badge {
      position: absolute;
      top: -2px; right: -2px;
      width: 17px; height: 17px;
      border-radius: 50%;
      font-size: 10px;
      font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      color: #fff;
    }
    .badge-indigo { background: #5b5fcf; }
    .avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: #cbd5e0;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; color: #fff; font-size: 14px;
      cursor: pointer;
    }
    .content {
      padding: 1.6rem 2rem;
      flex: 1;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* ── PAGE-SPECIFIC STYLES ── */

    .page-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      margin-bottom: 1.6rem;
    }
    .page-title { font-size: 18px; font-weight: 700; color: #1a1a2e; }
    .device-name {
      font-size: 28px;
      font-weight: 800;
      color: #1a1a2e;
      text-align: center;
      letter-spacing: 1px;
    }
    .header-right {
      display: flex;
      justify-content: flex-end;
    }
    .header-links a {
      font-size: 14px;
      color: #6b7280;
      text-decoration: none;
      font-weight: 500;
    }
    .header-links a:hover { color: #1a8fc1; }
    .header-links-popover-wrap {
      position: relative;
      display: inline-flex;
    }
    .devices-popover {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      width: 250px;
      background: #fff;
      border: 1px solid #e8ecf0;
      border-radius: 10px;
      box-shadow: 0 12px 24px rgba(26, 35, 56, 0.12);
      padding: .7rem;
      display: none;
      z-index: 70;
    }
    .devices-popover.show { display: block; }
    .device-item-btn {
      width: 100%;
      text-align: left;
      border: none;
      cursor: pointer;
      font-family: inherit;
      background: transparent;
    }
    .device-item {
      border: 1px solid #eef2f7;
      border-radius: 8px;
      padding: .5rem .6rem;
      background: #f9fbfd;
      margin-bottom: .45rem;
    }
    .device-item:last-child { margin-bottom: 0; }
    .device-item strong {
      display: block;
      font-size: 12px;
      color: #1a1a2e;
      margin-bottom: 2px;
    }
    .device-item span {
      display: block;
      font-size: 12px;
      color: #6b7280;
    }
    .device-item-btn:hover .device-item { border-color: #1a8fc1; background: #eef7fc; }

    /* Chart cards */
    .chart-card {
      background: #fff;
      border: 1.5px solid #c8e6f5;
      border-radius: 14px;
      padding: 1.2rem 1.4rem;
      margin-bottom: 1.2rem;
    }

    .chart-header {
      display: flex;
      align-items: center;
      gap: .8rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    .chart-title {
      font-size: 15px;
      font-weight: 700;
      color: #1a1a2e;
      margin-right: auto;
      line-height: 1.3;
    }

    .period-btn {
      background: none;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      padding: 4px 14px;
      font-size: 12px;
      color: #6b7280;
      cursor: pointer;
      transition: all .15s;
      white-space: nowrap;
    }
    .period-btn.active {
      background: #fff;
      border-color: #1a1a2e;
      color: #1a1a2e;
      font-weight: 600;
    }
    .period-btn:hover:not(.active) { border-color: #1a8fc1; color: #1a8fc1; }

    /* Daily dropdown */
    .daily-dropdown {
      position: relative;
      display: inline-block;
    }
    .daily-btn {
      background: none;
      border: none;
      font-size: 12px;
      color: #6b7280;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      font-family: 'Segoe UI', sans-serif;
      padding: 4px 6px;
    }
    .daily-btn:hover { color: #1a8fc1; }
    .daily-arrow { font-size: 10px; }

    .daily-menu {
      display: none;
      position: absolute;
      right: 0; top: 110%;
      background: #fff;
      border: 1px solid #e8ecf0;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0,0,0,.08);
      z-index: 10;
      min-width: 110px;
      overflow: hidden;
    }
    .daily-menu.open { display: block; }
    .daily-menu a {
      display: block;
      padding: 8px 14px;
      font-size: 12px;
      color: #4a5568;
      text-decoration: none;
      transition: background .12s;
    }
    .daily-menu a:hover { background: #f0f7fb; color: #1a8fc1; }

    .chart-wrap { position: relative; height: 210px; }
    .chart-wrap-sm { position: relative; height: 180px; }

    /* Bottom row */
    .bottom-row {
      display: grid;
      grid-template-columns: 1fr 240px;
      gap: 1.2rem;
    }

    /* Stat cards */
    .stat-stack { display: flex; flex-direction: column; gap: 1rem; }

    .stat-card {
      background: #fff;
      border: 1.5px solid #c8e6f5;
      border-radius: 12px;
      padding: 1rem 1.4rem 1.2rem;
      position: relative;
      overflow: hidden;
      flex: 1;
    }
    .stat-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, #1a8fc1, #29b6d1);
    }
    .stat-label { font-size: 12px; color: #9aa3af; margin-bottom: 8px; }
    .stat-value { font-size: 24px; font-weight: 700; color: #1a1a2e; }
    .stat-unit  { font-size: 13px; font-weight: 400; color: #6b7280; margin-left: 2px; }
  <%- include('partials/glass-app-theme') %>
  </style>
</head>
<body>
